// ═══════════════════════════════════════════════════════════════════════════
//  GenomeForge — whole-genome germline joint-calling pipeline
//  FASTQ (any Illumina lane layout) -> bwa-mem2 -> MarkDuplicates -> BQSR ->
//  scattered HaplotypeCaller -> GenomicsDB -> GenotypeGVCFs -> VQSR -> normalise ->
//  dbSNP / gnomAD / ClinVar / VEP annotation -> cohort QC (somalier, PCA, MultiQC)
//
//  Site-specific paths (reference bundle, containers, scheduler) live in a site
//  profile (conf/<site>.config) or a -params-file; nothing here points at one cluster.
// ═══════════════════════════════════════════════════════════════════════════

manifest {
    name            = 'GenomeForge'
    description     = 'Whole-genome germline joint calling: FASTQ to an annotated, QC-ed cohort callset'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}

params {
    help            = false
    input           = null              // sample sheet CSV, one row per lane-pair: sample_id,lane_id,library,flowcell,lane,fastq_1,fastq_2[,sex,phenotype]
    outdir          = 'results'
    publish_mode    = 'copy'

    // ---- reference: chr-style no-alt GRCh38 with bwa-mem2 index, .fai and .dict next to it
    fasta           = null
    calling_regions = null              // GATK wgs_calling_regions interval_list or a BED; null => primary chromosomes from .fai
    scatter_count   = 48                // HaplotypeCaller / joint-genotyping shards
    scatter_mode    = null              // SplitIntervals --subdivision-mode; null => auto
    bqsr_scatter    = 24                // BaseRecalibrator / ApplyBQSR shards (whole-contig groups over the full reference)

    // ---- alignment task size. Default: two 32-thread tasks per 72-thread node. With
    //      whole_node_align, one 64-thread task per node: same throughput, half the wall-clock
    //      per task, i.e. half the work at risk when a node loses power.
    whole_node_align = false
    align_cpus      = 32
    align_memory    = '64.GB'
    node_cpus       = 64
    node_memory     = '120.GB'

    // ---- known sites (BQSR), VQSR training sets, annotation databases (same contig style as fasta)
    dbsnp           = null
    mills           = null
    known_indels    = null
    hapmap          = null              // VQSR SNP training (bin/fetch_resources.sh)
    omni            = null
    g1000           = null
    clinvar         = null              // may be Ensembl-named; renamed to the reference style in PREP_CLINVAR
    gnomad_dir      = null              // directory of per-chromosome gnomAD sites files
    gnomad_pattern  = 'gnomad.exomes.v4.1.sites.{chrom}.vcf.bgz'
    gnomad_fields   = 'AF,AF_afr,AF_grpmax,nhomalt'    // INFO fields copied as gnomAD_<field>
    somalier_sites  = null
    vep_cache       = null              // directory containing homo_sapiens/<release>_GRCh38
    vep_release     = 112
    vep_extra       = ''
    verifybamid_svd = null              // SVD prefix (…/1000g.phase3.100k.b38.vcf.gz.dat); null => auto-detect inside the cohortqc image

    // ---- behaviour
    trim            = true              // fastp adapter/quality trimming streamed into bwa-mem2
    fastp_qual      = 20
    fastp_min_len   = 30
    sequencing_center = null            // read-group CN tag; null => omitted
    filtering       = 'vqsr'            // vqsr | hard  (falls back to hard if the VQSR training sets are absent)
    snp_tranche     = 99.7
    indel_tranche   = 99.7
    snp_filter_expr   = 'QD < 2.0 || FS > 60.0 || MQ < 40.0 || MQRankSum < -12.5 || ReadPosRankSum < -8.0 || SOR > 3.0'
    indel_filter_expr = 'QD < 2.0 || FS > 200.0 || ReadPosRankSum < -20.0 || SOR > 10.0'
    chromosomes     = 'chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY,chrM'
    archive_cram    = false             // also write CRAM next to the final BAM
    run_contamination = true            // verifyBamID2 (needs the SVD resource inside the cohortqc image)
    run_pca         = true              // plink2 PCA on LD-pruned common SNPs
    run_vep         = true

    // ---- per-sample QC thresholds (flag only; nothing is dropped)
    qc_min_depth    = 20
    qc_max_dup      = 0.25
    qc_max_contam   = 0.03
    qc_min_mapped   = 0.95

    // ---- containers (CallForge images; set per site)
    callforge_sif   = null              // core: bwa-mem2, samtools, bcftools, GATK, picard, fastp, mosdepth, multiqc, python
    annotate_sif    = null              // ensembl-vep + vcfanno
    cohortqc_sif    = null              // somalier, peddy, verifybamid2
    burden_sif      = null              // plink2, regenie
    vep_container   = null              // e.g. 'ensemblorg/ensembl-vep:release_112.0' to use the official image instead of annotate_sif
    bind_paths      = null              // host paths to bind into containers (comma list)
    container_cache = "${System.getenv('HOME')}/.genomeforge/container_cache"

    max_retries     = 2
    slurm_partition = null
    slurm_account   = null
    slurm_exclude   = null              // nodes to keep free, e.g. 'node4' (comma list)
}

includeConfig 'conf/base.config'

profiles {
    noguchi { includeConfig 'conf/noguchi.config' }   // Noguchi HPC (SLURM + Apptainer + CallForge images)
    slurm   { includeConfig 'conf/slurm.config' }     // generic SLURM + Singularity/Apptainer site
    stub    { includeConfig 'conf/stub.config' }
    local   { process.executor = 'local' }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"
           fields = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,memory,%mem,peak_rss,peak_vmem,rchar,wchar,workdir' }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
