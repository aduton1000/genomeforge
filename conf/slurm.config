// Generic SLURM + Singularity/Apptainer site. Supply the reference bundle, containers and
// partition through a -params-file (copy params.example.yaml) or on the command line.
process {
    executor         = 'slurm'
    queue            = { params.slurm_partition ?: null }
    clusterOptions   = { [params.slurm_account ? "--account=${params.slurm_account}" : '',
                          params.slurm_exclude ? "--exclude=${params.slurm_exclude}" : ''].findAll { it }.join(' ') ?: null }
    scratch          = false
    container        = params.callforge_sif
    containerOptions = { params.bind_paths ? "--bind ${params.bind_paths}" : null }

    withName: 'VEP_CHROM'                                   { container = params.vep_container ?: params.annotate_sif }
    withName: 'SOMALIER_EXTRACT|SOMALIER_RELATE|VERIFYBAMID' { container = params.cohortqc_sif }
    withName: 'PLINK_PCA'                                   { container = params.burden_sif }
}

executor {
    queueSize         = 150
    submitRateLimit   = '30/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
}

singularity {
    enabled      = true
    autoMounts   = true
    cacheDir     = params.container_cache
    envWhitelist = 'TMPDIR'
}
