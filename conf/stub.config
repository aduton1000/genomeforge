// Local dry run of the DAG with `-stub-run` (no containers, tiny resources).
process {
    executor = 'local'
    withLabel: 'align|markdup|bqsr_shard|gather|qc|wgsmetrics|hc|gdb|genotype|vqsr|vep|medium|small' {
        cpus = 1; memory = '1.GB'; time = '1.h'
    }
}
singularity.enabled = false
params.scatter_count = 4
params.bqsr_scatter  = 3
params.max_retries   = 0
