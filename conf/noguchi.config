// Noguchi HPC site profile: SLURM partition `global`, Apptainer (invoked as `singularity`),
// CallForge images and reference bundle under /hpc/opt/callforge. Everything here can be
// overridden by -params-file or --param on the command line.
params {
    slurm_partition = 'global'
    bind_paths      = '/hpc'

    fasta           = '/hpc/opt/callforge/refs/GRCh38_chr/GRCh38.full.chr.fa'            // chr-style, 194 contigs, no alts
    calling_regions = '/hpc/opt/callforge/refs/annotation_db/wgs_calling_regions.hg38.interval_list'   // bin/fetch_resources.sh

    dbsnp           = '/hpc/opt/callforge/refs/annotation_db/dbsnp.chr.vcf.gz'
    mills           = '/hpc/opt/callforge/refs/annotation_db/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    known_indels    = '/hpc/opt/callforge/refs/annotation_db/Homo_sapiens_assembly38.known_indels.vcf.gz'
    hapmap          = '/hpc/opt/callforge/refs/annotation_db/hapmap_3.3.hg38.vcf.gz'                       // bin/fetch_resources.sh
    omni            = '/hpc/opt/callforge/refs/annotation_db/1000G_omni2.5.hg38.vcf.gz'                    // bin/fetch_resources.sh
    g1000           = '/hpc/opt/callforge/refs/annotation_db/1000G_phase1.snps.high_confidence.hg38.vcf.gz' // bin/fetch_resources.sh
    clinvar         = '/hpc/opt/callforge/refs/annotation_db/clinvar.vcf.gz'
    gnomad_dir      = '/hpc/opt/callforge/refs/annotation_db'
    somalier_sites  = '/hpc/opt/callforge/refs/annotation_db/sites.hg38.vcf.gz'
    vep_cache       = '/hpc/opt/callforge/refs/vep'

    callforge_sif   = '/hpc/opt/callforge/images/callforge.sif'
    annotate_sif    = '/hpc/opt/callforge/images/callforge-annotate.sif'
    cohortqc_sif    = '/hpc/opt/callforge/images/callforge-cohortqc.sif'
    burden_sif      = '/hpc/opt/callforge/images/callforge-burden.sif'
}

includeConfig 'slurm.config'
