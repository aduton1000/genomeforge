// Per-label resources. The Noguchi nodes are 72 threads / 1 TB; the partition has no
// time limit, so `time` only sets the SLURM --time of each task. Memory/time grow with
// task.attempt on retry. CPUs are given only where the tool uses them (bwa-mem2, samtools,
// mosdepth, bcftools compression, VEP forks, HaplotypeCaller PairHMM, GenomicsDB readers);
// the single-threaded GATK steps keep 2 cpus and gain speed from scattering instead.
process {
    cpus          = 1
    memory        = { 4.GB * task.attempt }
    time          = { 6.h  * task.attempt }
    errorStrategy = { task.attempt <= params.max_retries ? 'retry' : 'finish' }
    // Cache keys from path + size, not modification time: on an NFS-served work directory a
    // server restart or client replay can bump the mtime of a finished file and silently
    // invalidate everything downstream of it (see docs/decisions.md, October 2026).
    cache         = params.cache_mode
    maxRetries    = params.max_retries
    // every task gets a private tmp dir on the (disk-backed) work filesystem — /tmp on
    // the cluster is RAM-backed tmpfs
    beforeScript  = 'mkdir -p "$PWD/tmp"; export TMPDIR="$PWD/tmp"'

    withLabel: 'align'      { cpus   = { (params.whole_node_align.toString().toLowerCase() in ['true', '1', 'yes'] ? params.node_cpus : params.align_cpus) as int }
                              memory = { ((params.whole_node_align.toString().toLowerCase() in ['true', '1', 'yes'] ? params.node_memory : params.align_memory) as nextflow.util.MemoryUnit) * task.attempt }
                              time   = { 36.h * task.attempt } }
    withLabel: 'markdup'    { cpus = 12; memory = { 64.GB * task.attempt }; time = { 36.h * task.attempt } }
    withLabel: 'bqsr_shard' { cpus = 2;  memory = { 8.GB  * task.attempt }; time = { 6.h  * task.attempt } }
    withLabel: 'gather'     { cpus = 8;  memory = { 24.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel: 'qc'         { cpus = 8;  memory = { 16.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: 'wgsmetrics' { cpus = 2;  memory = { 24.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: 'hc'         { cpus = 4;  memory = { 12.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: 'gdb'        { cpus = 8;  memory = { 40.GB * task.attempt }; time = { 48.h * task.attempt } }
    withLabel: 'genotype'   { cpus = 2;  memory = { 24.GB * task.attempt }; time = { 48.h * task.attempt } }
    withLabel: 'vqsr'       { cpus = 4;  memory = { 48.GB * task.attempt }; time = { 48.h * task.attempt } }
    withLabel: 'vep'        { cpus = 16; memory = { 32.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: 'medium'     { cpus = 8;  memory = { 24.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: 'small'      { cpus = 1;  memory = { 4.GB  * task.attempt }; time = { 6.h  * task.attempt } }
}
